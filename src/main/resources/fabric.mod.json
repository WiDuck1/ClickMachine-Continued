    "main": ["dev.shadowsoffire.clickmachine.ClickMachine"],
    "client": ["dev.shadowsoffire.clickmachine.ClickMachineClient"],
    "fabric-datagen": ["dev.shadowsoffire.clickmachine.data.ClickMachineDataGenerator"]
  },
  "mixins": ["clickmachine.mixins.json"],
